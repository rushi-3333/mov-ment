# ─── Development (local) ───
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/movment
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars

# Optional: comma-separated frontend URLs for CORS (leave empty in dev — all origins allowed)
# CLIENT_URL=http://localhost:5173

# Serve built React app from this server (auto true in production)
SERVE_CLIENT=false

# Create demo login accounts on startup (auto true in development)
SEED_DEMO_ACCOUNTS=true

# Allow in-memory MongoDB when Atlas/local DB is unreachable (development only)
ALLOW_MEMORY_DB=true
