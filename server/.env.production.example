# ─── Production ───
NODE_ENV=production
PORT=5000

# Required: MongoDB Atlas or managed MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/movmentDB?retryWrites=true&w=majority

# Required: long random secret (PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}) -as [byte[]]))
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Frontend URL(s) for CORS when UI is hosted separately — comma-separated
# Same-origin deploy (SERVE_CLIENT=true): set to your public URL, e.g. https://your-app.com
CLIENT_URL=https://your-app.example.com

# Serve React build from this server (recommended — one URL for UI + API)
SERVE_CLIENT=true

# Never use demo passwords in production
SEED_DEMO_ACCOUNTS=false

# Create owner on first start (use a strong password, 12+ chars)
OWNER_EMAIL=admin@yourcompany.com
OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD_12_CHARS_MIN
OWNER_NAME=Owner

# Behind nginx / Railway / Render / load balancer
TRUST_PROXY=true

# Optional release label in /api/health
APP_VERSION=1.0.0
